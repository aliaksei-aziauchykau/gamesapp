# Copy to ".env" at the gamesapp repo root for local Docker Compose.
#
# Compose merge helper:
#   .\merge-docker-compose.ps1
#
# Typical bring-up:
#   .\merge-docker-compose.ps1 up -d postgresql keycloak api ui

COMPOSE_PROJECT_NAME=gamesapp

# --- PostgreSQL ---
POSTGRES_DB=gamesapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# --- API ---
API_ENV_FILE_PATH=.env
API_ASPNETCORE_ENVIRONMENT=Development
API_ASPNETCORE_URLS=http://+:80
API_CORS_ALLOWED_ORIGINS=http://localhost:4200
API_DATABASE_CONNECTION_STRING=Host=gamesapp-postgresql;Port=5432;Database=gamesapp;Username=postgres;Password=postgres

# Keycloak JWT (set audience after you create the `gamesapp-api` client in Keycloak)
KEYCLOAK_AUTHORITY=http://gamesapp-keycloak:8080/realms/gamesapp
KEYCLOAK_AUDIENCE=gamesapp-api
KEYCLOAK_REQUIRE_HTTPS_METADATA=false

# Public issuer URL as seen by the browser (optional; defaults are fine for local stacks)
# KEYCLOAK_AUTHORITY=http://localhost:8180/realms/gamesapp

# --- Database migrator ---
DATABASE_MIGRATOR_CONNECTION_STRING=Host=gamesapp-postgresql;Port=5432;Database=gamesapp;Username=postgres;Password=postgres
DATABASE_MIGRATOR_SCRIPTS_PATH=Migrations/Up
DATABASE_MIGRATOR_JOURNAL_TABLE=SchemaVersions

# --- UI ---
UI_NODE_ENV=development
UI_PUBLIC_BASE_URL=http://localhost:4200

# --- Logging / monitoring ---
LOKI_HTTP_PORT=3100
GRAFANA_HTTP_PORT=3200
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GATUS_PORT=8088
GATUS_CONFIG_PATH=/config/config.yaml
