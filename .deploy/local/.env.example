# GamesApp — local deploy (StreamApp-style)
COMPOSE_PROJECT_NAME=vs-gamesapp-local
GAMESAPP_NETWORK_NAME=vs-gamesapp-local-network
GAMESAPP_DOCKER_PROFILE=local
GAMESAPP_SERVICES=gateway,postgresql,keycloak,api,ui,monitoring,logging,database-migrator

ROOT_WSL_PATH=

API_ENV_FILE_PATH=.env
API_ASPNETCORE_ENVIRONMENT=Development
API_ASPNETCORE_URLS=http://+:80
API_CORS_ALLOWED_ORIGINS=http://ui.gamesapp.local.projects.volnyja-siervisy.site,http://ui-dev.gamesapp.local.projects.volnyja-siervisy.site,http://localhost:4200,http://localhost:4201
API_DATABASE_CONNECTION_STRING=Host=gamesapp-postgresql;Port=5432;Database=gamesapp;Username=postgres;Password=postgres
KEYCLOAK_AUTHORITY=http://gamesapp-keycloak:8080/realms/gamesapp
KEYCLOAK_AUDIENCE=gamesapp-api
KEYCLOAK_REQUIRE_HTTPS_METADATA=false

DATABASE_MIGRATOR_CONNECTION_STRING=Host=gamesapp-postgresql;Port=5432;Database=gamesapp;Username=postgres;Password=postgres
DATABASE_MIGRATOR_SCRIPTS_PATH=Migrations/Up
DATABASE_MIGRATOR_JOURNAL_TABLE=SchemaVersions

POSTGRES_DB=gamesapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

UI_NODE_ENV=production
UI_PUBLIC_BASE_URL=http://ui.gamesapp.local.projects.volnyja-siervisy.site:9080

GATUS_PORT=8088
GATUS_CONFIG_PATH=/config/config.yaml
LOKI_HTTP_PORT=3100
GRAFANA_HTTP_PORT=3200
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
